map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
        server_name socket.scoreboard.acoes.cc;
        location / {
        proxy_pass http://localhost:5152;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400;
        }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/socket.scoreboard.acoes.cc/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/socket.scoreboard.acoes.cc/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    
}
server {
    if ($host = socket.scoreboard.acoes.cc) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


        server_name socket.scoreboard.acoes.cc;
    listen 80;
    return 404; # managed by Certbot


}